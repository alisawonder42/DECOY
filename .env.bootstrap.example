# Copy this file to `.env.bootstrap` in the repo root, then fill in values.
# `.env.bootstrap` is gitignored. Do not paste these secrets into git, chat, or client apps.
#
# After editing `.env.bootstrap`, run:
#   pnpm bootstrap:hosted

# Required. Create at https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Optional. Database password from Project Settings → Database.
# If this is wrong, bootstrap still applies schema via the Management API.
SUPABASE_DB_PASSWORD=

# Existing Decoy project (do not create a second project)
SUPABASE_PROJECT_REF=fjnuzhwefsdwnnovtjou

# Optional. Needed only to publish the visitor site on Cloudflare Pages.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
VISITOR_CUSTOM_DOMAIN=decoyexhibit.download

# Optional exhibition settings
# GALLERY_LATITUDE=
# GALLERY_LONGITUDE=
# OPENAI_API_KEY=
# ARTIST_OR_ORGANIZER_NAME=
# EXHIBITION_NAME=
# CONTACT_EMAIL=
# DATA_RETENTION_DESCRIPTION=
