# =============================================================================
# PUBLIC VISITOR WEB  (apps/visitor-web)
# Only publishable values. Never put OpenAI or Supabase secret keys here.
# =============================================================================
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Public exhibition identity shown in Terms & Privacy (not secrets).
VITE_ARTIST_OR_ORGANIZER_NAME=
VITE_EXHIBITION_NAME=
VITE_CONTACT_EMAIL=
VITE_TERMS_VERSION=1.0
# REQUIRED BEFORE PUBLIC LAUNCH. Do not invent a legal retention commitment.
VITE_DATA_RETENTION_DESCRIPTION=

# =============================================================================
# TABLET APP  (apps/tablet)
# =============================================================================
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_BASE_URL=
VITE_APP_VERSION=0.1.0
VITE_IMAGE_FIT=cover

# =============================================================================
# SERVER-SIDE ONLY  (Supabase Edge Function secrets / local privileged scripts)
# Set these in the Supabase dashboard secret manager, not in client bundles.
# =============================================================================
# OPENAI_API_KEY must be configured only as a Supabase server secret.
# Do not paste it into chat, git, Vite env, Capacitor config, or APK resources.

GALLERY_LATITUDE=
GALLERY_LONGITUDE=
GALLERY_RADIUS_METERS=200
MAX_LOCATION_ACCURACY_METERS=500
LOCATION_VERIFICATION_TTL_MINUTES=60

TERMS_VERSION=1.0

MAX_DAILY_SUBMISSIONS=200
MAX_GENERATION_ATTEMPTS=3

GENERATION_LEASE_MINUTES=5
READY_DISPLAY_LEASE_MINUTES=2
GENERATION_MIN_INTERVAL_SECONDS=13
TABLET_ONLINE_THRESHOLD_SECONDS=90

OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=low
OPENAI_IMAGE_SIZE=1024x1536
OPENAI_IMAGE_FORMAT=webp
OPENAI_IMAGE_COMPRESSION=

MOCK_IMAGE_GENERATION=true

VISITOR_WEB_ORIGIN=

ARTIST_OR_ORGANIZER_NAME=
EXHIBITION_NAME=
CONTACT_EMAIL=
DATA_RETENTION_DESCRIPTION=

# Development-only. Must be false in production.
DEV_SKIP_LOCATION_VERIFICATION=false

# Privileged local scripts (provision / seed / reset). Never ship in apps.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
