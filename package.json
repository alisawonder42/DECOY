{
  "name": "decoy-installation",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev:visitor": "pnpm --filter visitor-web dev",
    "dev:tablet": "pnpm --filter tablet dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "provision-tablet": "tsx scripts/provision-tablet.ts",
    "seed:tablets": "tsx scripts/seed-tablets.ts",
    "seed:submissions": "tsx scripts/seed-submissions.ts",
    "seed:reset": "tsx scripts/reset-installation.ts",
    "check:secrets": "tsx scripts/check-client-secrets.ts",
    "bootstrap:hosted": "tsx scripts/bootstrap-hosted.ts"
  },
  "dependencies": {
    "@installation/shared": "workspace:*",
    "@supabase/supabase-js": "^2.57.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "typescript": "~5.8.3",
    "vitest": "^3.2.4"
  }
}
